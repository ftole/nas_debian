# ==============================================================================
# Servidor NAS & Central de Respaldos (Debian 13) - Credenciales de Prueba
# ==============================================================================
# Copia este archivo a '.env' y completa las credenciales de tu máquina de prueba:
#   cp .env.example .env
#
# El archivo '.env' es estrictamente local y es ignorado por git (.gitignore).
# [LEGACY] Este archivo servía a 'test_remote.py'/'test_remote.sh', retirados en F7.
# Se conserva como referencia; la verificación vigente usa las suites Rust,
# el contrato de paridad y 'nasctl'.
# ==============================================================================

# Dirección IP o nombre de host resoluble de la máquina Debian 13 remota
NAS_TEST_IP=10.10.1.2

# Puerto del servicio SSH en el servidor remoto (por defecto: 22)
NAS_TEST_PORT=22

# Usuario con permisos de sudo en el servidor remoto (ej: sistemas o debian)
NAS_TEST_USER=sistemas

# Contraseña de acceso SSH para el usuario configurado
NAS_TEST_PASSWORD=cambiar_por_tu_contrasena

# Contraseña de root o sudo (si es la misma que NAS_TEST_PASSWORD, puedes dejarla igual)
NAS_ROOT_PASSWORD=cambiar_por_tu_contrasena_root
