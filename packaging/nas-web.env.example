# Variables de entorno del panel NAS (Rust). Permisos: 0600 root:root
# Generado por packaging/install.sh

NAS_WEB_BIND=127.0.0.1:8080
NAS_WEB_USER=admin
# openssl rand -hex 32
NAS_WEB_SECRET=cambiar_por_32_bytes_hex
# sha256 de la contraseña: printf '%s' 'CLAVE' | sha256sum
NAS_WEB_PASSWORD_SHA256=cambiar_por_hash_sha256
# Cookies Secure por defecto (solo desactivar en HTTP local de pruebas)
# NAS_WEB_INSECURE_COOKIE=1
NAS_WEB_TTL_SECS=28800

NAS_REPO_DIR=/opt/nas_debian
NAS_STATE_DIR=/var/lib/nas
NAS_DATA_ROOT=/srv/nas
NAS_SAMBA_CONF=/etc/samba/smb.conf
NAS_ROLE_FILE=/etc/nas/role
NAS_BACKUP_DIR=/usr/local/bin
NAS_INVENTORY=/etc/nas/inventory.yaml
