#!/bin/bash
# ==============================================================================
# Aplica ACLs POSIX (acceso y herencia) para un grupo sobre un recurso.
# Uso: nas-share-acl <ruta> <grupo|usuario> <read|write|none>
# ==============================================================================
set -euo pipefail

PATH_ARG="${1:-}"
PRINCIPAL="${2:-}"
LEVEL="${3:-none}"

case "$PATH_ARG" in
    /srv/nas/*) ;;
    *) echo "ruta no permitida" >&2; exit 2 ;;
esac
[[ "$PATH_ARG" != *".."* ]] || { echo "ruta inválida" >&2; exit 2; }

if [[ "$PRINCIPAL" =~ ^grp_[a-z0-9_]+$ ]]; then
    ENTRY="g:$PRINCIPAL"
elif [[ "$PRINCIPAL" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    ENTRY="u:$PRINCIPAL"
else
    echo "principal inválido" >&2
    exit 2
fi

[ -d "$PATH_ARG" ] || { echo "no existe el recurso" >&2; exit 3; }

case "$LEVEL" in
    read)  PERMS="r-x" ;;
    write) PERMS="rwx" ;;
    none)  setfacl -R -x "$ENTRY" "$PATH_ARG" 2>/dev/null || true
           setfacl -R -d -x "$ENTRY" "$PATH_ARG" 2>/dev/null || true
           echo "$PATH_ARG $ENTRY none"
           exit 0 ;;
    *) echo "nivel inválido" >&2; exit 2 ;;
esac

setfacl -R -m "$ENTRY:$PERMS" "$PATH_ARG"
setfacl -R -d -m "$ENTRY:$PERMS" "$PATH_ARG"
echo "$PATH_ARG $ENTRY $LEVEL"
