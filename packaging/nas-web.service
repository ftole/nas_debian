[Unit]
Description=Panel web NAS (Rust/axum)
Documentation=https://github.com/ftole/nas_debian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nas-web
Group=nas-web
SupplementaryGroups=grp_samba
EnvironmentFile=/etc/nas-web.env
ExecStart=/usr/local/bin/nas-web
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Endurecimiento. `sudo -n` requiere CAP_SETUID/SETGID y las acciones
# privilegiadas acotadas (btrfs/fstrim) necesitan CAP_SYS_ADMIN.
NoNewPrivileges=no
# ProtectHome=no porque useradd -m crea /home/<usuario>.
# ProtectSystem=yes (no strict) porque el helper validado escribe /etc/samba/smb.conf
# en el mismo namespace; /usr y /boot siguen protegidos y /etc es root-only.
ProtectSystem=yes
ProtectHome=no
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# /usr/local/bin y /usr/local/sbin: los helpers acotados instalan runners
# de respaldo y staging (nas-backup-manage vía nas helper). /etc/cron.d y
# /etc/backup-credentials admiten el ciclo completo de tareas.
ReadWritePaths=/var/lib/nas /srv/nas /usr/local/bin /usr/local/sbin -/etc/cron.d -/etc/backup-credentials -/etc/samba
UMask=0007
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN CAP_MKNOD CAP_AUDIT_WRITE CAP_KILL CAP_LINUX_IMMUTABLE
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN

[Install]
WantedBy=multi-user.target
