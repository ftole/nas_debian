#!/bin/bash
# ==============================================================================
# Aplica de forma atómica una configuración de Samba preparada por el panel.
# Uso: nas-samba-apply /var/lib/nas/staging/smbconf_XXXX
# ==============================================================================
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "uso: nas-samba-apply <smb.conf preparado>" >&2
    exit 2
fi

STAGED="$1"
case "$STAGED" in
    /var/lib/nas/staging/smbconf_*) ;;
    *) echo "ruta no permitida: $STAGED" >&2; exit 3 ;;
esac

[ -f "$STAGED" ] || { echo "no existe: $STAGED" >&2; exit 4; }

testparm -s "$STAGED" >/dev/null

BACKUP="/etc/samba/smb.conf.bak.$(date +%Y%m%d%H%M%S)"
cp -a /etc/samba/smb.conf "$BACKUP"
install -m 0644 -o root -g root "$STAGED" /etc/samba/smb.conf
rm -f "$STAGED"

systemctl reload smbd
echo "smb.conf aplicado (respaldo: $BACKUP)"
